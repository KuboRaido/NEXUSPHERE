-}
\ No newline at end of file
+}
+/* ===== 制作物（1件ずつ保存） ===== */
+[x-cloak] { display: none !important; }   /* Alpine が動く前に「新しい制作物」が一瞬見えるのを防ぐ */
+
+.work-form {
+  margin-top: 24px;
+  padding: 24px;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  background: var(--surface);
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
+}
+.work-form h3 { margin: 0; font-size: 1.125rem; }
+
+.tech-row { display: flex; gap: 8px; margin-bottom: 8px; }
+.tech-row input { flex: 1; }
+
+.hint { margin: 0; color: var(--muted); font-size: 0.875rem; }
+
+/* 画像の10枠：PC は2列、スマホは1列 */
+.work-images { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
+.work-image {
+  padding: 16px;
+  border: 1px dashed var(--border);
+  border-radius: 8px;
+  background: var(--bg);
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  min-width: 0;
+}
+.work-image__label { font-weight: 600; font-size: 0.875rem; }
+.work-image img { width: 100%; aspect-ratio: 4 / 3; object-fit: contain; background: var(--surface); border-radius: 4px; }
+.work-image input[type="file"] { max-width: 100%; font-size: 0.875rem; }
+@media (max-width: 480px) { .work-images { grid-template-columns: minmax(0, 1fr); } }
+
+.portfolio-edit .button--secondary { background: var(--bg); color: var(--text); border: 1px solid var(--border); }
+.portfolio-edit .button--secondary:hover { background: var(--surface); }
+.portfolio-edit .button--danger { background: var(--bg); color: var(--error-text); border: 1px solid var(--error-text); }
+.portfolio-edit .button--danger:hover { background: var(--error-bg); }
